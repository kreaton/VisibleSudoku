@page "/"
@using VisibleSudoku.Game

<PageTitle>VisibleSudoku</PageTitle>

<div class="app" tabindex="0" @onkeydown="OnKey">
    <header class="topbar">
        <div class="title">VisibleSudoku</div>
    </header>

    @if (game is not null)
    {
        <div class="status">
            <span>@game.Difficulty</span>
            <span aria-label="Time">@TimeText</span>
            <span>Mistakes: @game.Mistakes</span>
        </div>

        <div class="board-wrap">
            <div class="board" role="grid" aria-label="Sudoku board">
                @for (int i = 0; i < 81; i++)
                {
                    int idx = i;
                    <button type="button" class="@CellClass(idx)" aria-label="@CellLabel(idx)" @onclick="() => Select(idx)">
                        @if (game.Values[idx] != 0)
                        {
                            @game.Values[idx]
                        }
                    </button>
                }
            </div>
        </div>

        <div class="msg" role="status" aria-live="polite">@message</div>

        <div class="numpad">
            @for (int n = 1; n <= 9; n++)
            {
                int d = n;
                int left = Remaining(d);
                <button type="button" class="btn num" disabled="@(left <= 0)" @onclick="() => Input(d)"
                        aria-label="@($"Number {d}, {Math.Max(left, 0)} left")">@d</button>
            }
            <button type="button" class="btn num undo" @onclick="Undo" disabled="@(undo.Count == 0)" aria-label="Undo" title="Undo">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14L4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-4"/></svg>
            </button>
        </div>

        <div class="actions">
            <button type="button" class="btn act erase" @onclick="Erase" aria-label="Erase" title="Erase">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 5H9l-7 7 7 7h12z"/><path d="M12 9l6 6M18 9l-6 6"/></svg>
            </button>
            <button type="button" class="btn act new" @onclick="OpenMenu" aria-label="New game" title="New game">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M4 12h16"/></svg>
            </button>
            <button type="button" class="btn act theme" @onclick="ToggleTheme"
                    aria-label="@(dark ? "Switch to light display" : "Switch to dark display")" title="@(dark ? "Light display" : "Dark display")">
                @if (dark)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
                }
            </button>
            <button type="button" class="btn act hint" @onclick="Hint" aria-label="Hint" title="Hint">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/></svg>
            </button>
            <button type="button" class="btn act check" @onclick="Check" aria-label="Check" title="Check">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>
            </button>
        </div>
    }

    @if (busy)
    {
        <div class="overlay"><h1>Making a puzzle…</h1></div>
    }
    else if (game is { Completed: true })
    {
        <div class="overlay">
            <h1>Well done!</h1>
            <p>@game.Difficulty puzzle solved in @TimeText</p>
            <p>Mistakes: @game.Mistakes &nbsp; Hints: @game.Hints</p>
            <div class="hdr">Play again</div>
            @DifficultyButtons
        </div>
    }
    else if (menuOpen || game is null)
    {
        <div class="overlay start">
            <img class="start-icon" src="icon-192.png" alt="" width="72" height="72" />
            <h1>VisibleSudoku</h1>
            @if (saved is not null)
            {
                <button type="button" class="btn menu-btn cont" @onclick="Continue">
                    Continue game
                    <small>@saved.Difficulty · @FormatTime(saved.Seconds)</small>
                </button>
            }
            <div class="hdr">New game</div>
            @DifficultyButtons
            @if (game is not null)
            {
                <button type="button" class="btn menu-btn" @onclick="CloseMenu">Back to puzzle</button>
            }
            <footer class="credits">
                <div>Version @AppVersion · © 2026 Per Hejndorf</div>
                <div><a href="https://github.com/kreaton/VisibleSudoku/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a>
                    · <a href="https://github.com/kreaton/VisibleSudoku" target="_blank" rel="noopener">Source on GitHub</a></div>
            </footer>
        </div>
    }
</div>

@code {
    RenderFragment DifficultyButtons => @<text>
        <button type="button" class="btn menu-btn" @onclick="() => StartNew(Difficulty.Easy)">Easy<small>Lots of numbers given</small></button>
        <button type="button" class="btn menu-btn" @onclick="() => StartNew(Difficulty.Medium)">Medium<small>A comfortable challenge</small></button>
        <button type="button" class="btn menu-btn" @onclick="() => StartNew(Difficulty.Hard)">Hard<small>Fewer numbers given</small></button>
        <button type="button" class="btn menu-btn" @onclick="() => StartNew(Difficulty.Expert)">Expert<small>Very few numbers, needs deeper thinking</small></button>
    </text>;
}
